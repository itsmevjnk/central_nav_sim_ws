<launch>
    <arg name="name" />
    <arg name="namespace" default="/" />

    <node name="timer" pkg="benchmark_tools" exec="bumper_node" output="screen" namespace="$(var namespace)">
        <param name="use_sim_time" value="true" /> <!-- of course we are -->
        <param name="robot_name" value="$(var name)" />
    </node>
</launch>
